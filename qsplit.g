# The matrix of multiplication by zeta on Z[zeta_p], in the basis 1, zeta, ..., zeta^(p-2).
# Input: a prime p. Output: a (p-1)x(p-1) integer matrix.
ZetaMat := function(p)
  local d, Z, i;
  d := p - 1;
  Z := NullMat(d, d);
  for i in [1 .. d - 1] do
    Z[i + 1][i] := 1;
  od;
  for i in [1 .. d] do
    Z[i][d] := -1;
  od;
  return Z;
end;

# The matrix of multiplication by an element u of Z[zeta_p].
# Input: p and u (a list of length p-1). Output: a (p-1)x(p-1) integer matrix.
EltMat := function(p, u)
  local Z, d, M, P, i;
  Z := ZetaMat(p);
  d := p - 1;
  M := NullMat(d, d);
  P := IdentityMat(d);
  for i in [1 .. d] do
    if u[i] <> 0 then
      M := M + u[i] * P;
    fi;
    P := Z * P;
  od;
  return M;
end;

# The product u*v of two elements of Z[zeta_p].
MulElt := function(p, u, v)
  return EltMat(p, u) * v;
end;

# The element zeta^a of Z[zeta_p], as a list of length p-1.
ZetaPower := function(p, a)
  local v;
  a := a mod p;
  if a < p - 1 then
    v := List([1 .. p - 1], i -> 0);
    v[a + 1] := 1;
  else
    v := List([1 .. p - 1], i -> -1);
  fi;
  return v;
end;

# The sum of zeta^a over all a in the list S (a Gaussian period when S is a coset).
PeriodElt := function(p, S)
  return Sum(S, a -> ZetaPower(p, a));
end;

# The ideal of Z[zeta_p] generated by the elements in gens.
# Output: a Z-basis of the ideal in Hermite normal form.
IdealFromGens := function(p, gens)
  local Z, rows, g, v, i, H;
  Z := ZetaMat(p);
  rows := [];
  for g in gens do
    v := ShallowCopy(g);
    for i in [1 .. p - 1] do
      Add(rows, v);
      v := Z * v;
    od;
  od;
  H := HermiteNormalFormIntegerMat(rows);
  return Filtered(H, r -> not IsZero(r));
end;

# The norm of an ideal I, i.e. its index in Z[zeta_p].
IdealNorm := function(I)
  return AbsInt(DeterminantIntMat(I));
end;

# Checks whether the vector v lies in the lattice spanned by the rows of B.
IsInLattice := function(B, v)
  return SolutionIntMat(B, v) <> fail;
end;

# Checks whether the ideal I is contained in the ideal J.
IsSubIdeal := function(I, J)
  return ForAll(I, v -> IsInLattice(J, v));
end;

# Checks whether the ideals I and J are equal.
IsEqualIdeal := function(I, J)
  return IsSubIdeal(I, J) and IsSubIdeal(J, I);
end;

# The product of the ideals I and J, as a Z-basis in Hermite normal form.
IdealProduct := function(p, I, J)
  local rows, a, b, H;
  rows := [];
  for a in I do
    for b in J do
      Add(rows, MulElt(p, a, b));
    od;
  od;
  H := HermiteNormalFormIntegerMat(rows);
  return Filtered(H, r -> not IsZero(r));
end;

# A prime ideal of Z[zeta_p] above the prime ell (ell <> p), namely (ell, g(zeta))
# for an irreducible factor g of the p-th cyclotomic polynomial mod ell.
# Output: a record with the ideal, its residue degree and the number of primes above ell.
PrimeAbove := function(p, ell)
  local F, x, phi, fac, g, coeffs, gvec;
  F := GF(ell);
  x := Indeterminate(F, "x");
  phi := Sum([0 .. p - 1], i -> x^i);
  fac := Factors(PolynomialRing(F, [x]), phi);
  g := fac[1];
  coeffs := List(CoefficientsOfUnivariatePolynomial(g), IntFFE);
  gvec := List([1 .. p - 1], i -> 0);
  gvec{[1 .. Length(coeffs)]} := coeffs;
  return rec(ideal := IdealFromGens(p, [ell * ZetaPower(p, 0), gvec]),
             residueDegree := DegreeOfLaurentPolynomial(g),
             numberOfPrimes := Length(fac));
end;

# The lattice E_a = { (y,k) in a + Z : y = k*y0 mod (1-zeta)a } with sigma(y,k) = (zeta*y, k).
# Input: p, an ideal a and optionally y0 in a but not in (1-zeta)a.
# Output: a record with the p x p matrix A of sigma, the basis of E_a, y0, and (1-zeta)a.
EMatrix := function(arg)
  local p, a, y0, Z, d, oneMinusZeta, H1, B, bigZ, A, j, img;
  p := arg[1];
  a := arg[2];
  d := p - 1;
  Z := ZetaMat(p);
  oneMinusZeta := ZetaPower(p, 0) - ZetaPower(p, 1);
  H1 := Filtered(HermiteNormalFormIntegerMat(
            List(a, b -> MulElt(p, oneMinusZeta, b))), r -> not IsZero(r));
  if Length(arg) >= 3 then
    y0 := arg[3];
    if not IsInLattice(a, y0) or IsInLattice(H1, y0) then
      Error("y0 must lie in a but not in (1-zeta)a");
    fi;
  else
    y0 := First(a, v -> not IsInLattice(H1, v));
  fi;
  B := List(H1, v -> Concatenation(v, [0]));
  Add(B, Concatenation(y0, [1]));
  bigZ := NullMat(p, p);
  bigZ{[1 .. d]}{[1 .. d]} := Z;
  bigZ[p][p] := 1;
  A := [];
  for j in [1 .. p] do
    img := bigZ * B[j];
    Add(A, SolutionIntMat(B, img));
  od;
  return rec(A := TransposedMat(A), basis := B, y0 := y0, H1 := H1);
end;

# The permutation matrix of a p-cycle.
CycleMatrix := function(p)
  local P, j;
  P := NullMat(p, p);
  for j in [1 .. p] do
    P[(j mod p) + 1][j] := 1;
  od;
  return P;
end;

# A Z-basis (as rows) of the integer kernel { x : M x = 0 }.
ColumnKernel := function(M)
  return NullspaceIntMat(TransposedMat(M));
end;

